<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🍷</text></svg>">
    <title>{{ title }}</title>
    <link rel="stylesheet" href="css/main.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Lato:wght@300;400;700&display=swap" rel="stylesheet">
</head>
<body>

    <header class="site-header" id="header">
        <div class="container header-inner">
            <a href="index.html" class="logo">
                <img src="img/logo.png" alt="Michelangelo" class="logo-img">
            </a>
            <nav class="main-nav" id="mainNav">
                {%- for link in [["index.html", "Home"], ["speisekarte.html", "Speisekarte"], ["catering.html", "Catering"], ["galerie.html", "Galerie"], ["kontakt.html", "Kontakt"]] %}
                <a href="{{ link[0] }}" class="nav-link{% if page.filePathStem + '.html' == '/' + link[0] %} active{% endif %}">{{ link[1] }}</a>
                {%- endfor %}
            </nav>
            <button class="menu-toggle" id="menuToggle" aria-label="Menü öffnen">
                <span></span><span></span><span></span>
            </button>
        </div>
    </header>
{{ content | safe }}
    <footer class="site-footer">
        <div class="container">
            <div class="footer-grid">
                <div class="footer-brand">
                    <a href="get10.html" class="logo-icon">🍷</a>
                    <span class="logo-text">Michelangelo</span>
                    <p>Bistrorante &amp; Pizzeria – Familie Sangiovanni, Bad Salzschlirf.</p>
                    <p><a href="mailto:info@bistrorante-michelangelo.de">info@bistrorante-michelangelo.de</a></p>
                </div>
                <div class="footer-links">
                    <h4>Navigation</h4>
                    <a href="index.html">Home</a>
                    <a href="speisekarte.html">Speisekarte</a>
                    <a href="catering.html">Catering</a>
                    <a href="galerie.html">Galerie</a>
                    <a href="kontakt.html">Kontakt & Anfahrt</a>
                </div>
                <div class="footer-links">
                    <h4>Rechtliches</h4>
                    <a href="impressum.html">Impressum</a>
                    <a href="datenschutz.html">Datenschutzerklärung</a>
                    <a href="allergene.html">Allergene</a>
                </div>
                <div class="footer-social">
                    <h4>Folgen Sie uns</h4>
                    <div class="social-links">
                        <a href="https://www.facebook.com/Michelangelo-Bistrorante-Pizzeria-126734194174649/" aria-label="Facebook" target="_blank" rel="noopener">Facebook</a>
                        <a href="https://www.instagram.com/michelangelo_bistrorante/" aria-label="Instagram" target="_blank" rel="noopener">Instagram</a>
                    </div>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2026 Bistrorante &amp; Pizzeria „Michelangelo". Alle Rechte vorbehalten.</p>
            </div>
        </div>
    </footer>

    <script type="module" src="js/main.js"></script>
</body>
</html>
